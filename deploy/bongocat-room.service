[Unit]
Description=BongoCat room server
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=exec
WorkingDirectory=/srv/BongoCat
ExecStart=/usr/bin/docker compose -f compose.yaml -f deploy/compose.caddy.yaml up --no-build --pull never --no-color --exit-code-from room
ExecStop=/usr/bin/docker compose -f compose.yaml -f deploy/compose.caddy.yaml stop --timeout 15
Restart=always
RestartSec=5s
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target docker.service
